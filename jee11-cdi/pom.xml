<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.gedoplan.showcase</groupId>
    <artifactId>jee11-demo</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  
  <artifactId>jee11-cdi</artifactId>

  <packaging>war</packaging>

  <properties>
    <java.code.version>17</java.code.version>

    <version.openliberty-group>io.openliberty.beta</version.openliberty-group>
    <version.openliberty-runtime>24.0.0.5-beta</version.openliberty-runtime>
  </properties>

  <dependencies>
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-web-api</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <defaultGoal>package</defaultGoal>
    <finalName>${project.artifactId}</finalName>

    <plugins>
      <plugin>
        <groupId>org.wildfly.plugins</groupId>
        <artifactId>wildfly-jar-maven-plugin</artifactId>
        <configuration>
          <feature-pack-location>wildfly-preview@maven(org.jboss.universe:community-universe)#${wildfly.version}</feature-pack-location>
          <layers>
            <layer>jaxrs-server</layer>
            <layer>microprofile-platform</layer>
            <layer>microprofile-rest-client</layer>
          </layers>
          <cli-sessions>
            <cli-session>
              <script-files>
                <script>src/main/wildfly/cli/logging.cli</script>
              </script-files>
            </cli-session>
          </cli-sessions>
        </configuration>
      </plugin>

      <plugin>
        <groupId>io.openliberty.tools</groupId>
        <artifactId>liberty-maven-plugin</artifactId>
        <version>3.10.3</version>
        <configuration>
          <assemblyArtifact>
            <groupId>io.openliberty.beta</groupId>
            <artifactId>openliberty-runtime</artifactId>
            <version>25.0.0.1-beta</version>
            <type>zip</type>
          </assemblyArtifact>
          <serverName>${project.artifactId}-server</serverName>
          <bootstrapProperties>
            <default.http.port>8080</default.http.port>
            <default.https.port>8443</default.https.port>
            <app.location>${project.artifactId}.war</app.location>
            <app.context.root>/</app.context.root>
          </bootstrapProperties>
        </configuration>
      </plugin>

    </plugins>
  </build>
</project>
