<server description="LibertyServer">
	<featureManager>
		<feature>cdi-4.1</feature>
		<feature>restfulWS-4.0</feature>
	</featureManager>
	
	<httpEndpoint host="*" httpPort="${default.http.port}" httpsPort="${default.https.port}" id="defaultHttpEndpoint"/>

	<webApplication location="${app.location}" contextRoot="${app.context.root}"/>

	<logging consoleLogLevel="INFO" isoDateFormat="true" traceFileName="stdout" traceSpecification="*=warning:de.gedoplan=fine" />

</server>