<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
				 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
				 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<packaging>pom</packaging>

	<modules>
		<module>jee11-cdi</module>
		<module>jee11-concurrency</module>
		<module>jee11-persistence</module>
	</modules>

	<groupId>de.gedoplan.showcase</groupId>
	<artifactId>jee11-demo</artifactId>
	<version>1.0-SNAPSHOT</version>

	<properties>
		<java.code.version>21</java.code.version>
		<maven.compiler.source>${java.code.version}</maven.compiler.source>
		<maven.compiler.target>${java.code.version}</maven.compiler.target>

		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<maven.compiler.parameters>true</maven.compiler.parameters>

		<skipTests>true</skipTests>

		<wildfly.version>35.0.0.Final</wildfly.version>
		<wildfly.bootable.jar.version>11.0.2.Final</wildfly.bootable.jar.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>jakarta.platform</groupId>
				<artifactId>jakarta.jakartaee-api</artifactId>
				<version>10.0.0</version>
			</dependency>
			<dependency>
				<groupId>jakarta.platform</groupId>
				<artifactId>jakarta.jakartaee-web-api</artifactId>
				<version>11.0.0-M4</version>
			</dependency>

			<dependency>
				<groupId>org.eclipse.microprofile</groupId>
				<artifactId>microprofile</artifactId>
				<version>7.0</version>
				<type>pom</type>
			</dependency>

			<dependency>
				<groupId>commons-logging</groupId>
				<artifactId>commons-logging</artifactId>
				<version>1.2</version>
			</dependency>

			<dependency>
				<groupId>org.projectlombok</groupId>
				<artifactId>lombok</artifactId>
				<version>1.18.32</version>
				<scope>compile</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<defaultGoal>package</defaultGoal>
		<finalName>${project.artifactId}</finalName>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.wildfly.plugins</groupId>
					<artifactId>wildfly-jar-maven-plugin</artifactId>
					<version>11.0.2.Final</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
